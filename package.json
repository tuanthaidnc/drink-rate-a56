{
  "name": "not-drink-reviewer-a56",
  "private": true,
  "version": "17.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json README.md",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "node --experimental-strip-types tests/browser-smoke.mjs",
    "preview": "vite preview",
    "build:android": "npm run typecheck && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/share": "8.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.8.0",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "^4.0.17",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "rimraf": {
      "glob": "14.0.2"
    }
  }
}
